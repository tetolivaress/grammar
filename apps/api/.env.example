# Copy to .env and adjust. Never commit the real .env.

# SQLite file (swap for a postgres:// URL if you migrate providers)
DATABASE_URL="file:./dev.db"

# 32+ random chars — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public URL of this API (used for auth cookies/origins)
BETTER_AUTH_URL="http://localhost:3003"

PORT=3003
