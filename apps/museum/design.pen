                  "fontFamily": "$font-body",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "ko0du",
                  "name": "P2",
                  "fill": "$ink-soft",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When a rule has a location, a color, and a shape, it stops being a line in a textbook and becomes somewhere you've been. That's what makes it stick.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
